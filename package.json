{
  "name": "rapier-for-bacteria",
  "version": "1.0.0",
  "description": "Rod-shaped bacteria growing and dividing as a monolayer in a microfluidic chamber, on the Rapier 2D physics engine",
  "private": true,
  "type": "module",
  "scripts": {
    "tangle": "sh tools/tangle.sh",
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "http-server -c-1 -o index.html",
    "simulate": "node build/run.js",
    "docs": "quarto render docs",
    "preview-docs": "quarto preview docs",
    "build-site": "npm run build && npm run docs && sh tools/build-site.sh",
    "clean": "rm -rf build _site docs/_site"
  },
  "dependencies": {
    "@dimforge/rapier2d-simd-compat": "0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "http-server": "^14.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
